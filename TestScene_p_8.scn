<?xml version="1.0"?>
<Node name="root" dt="0.01" gravity="0 0 0">
    <RequiredPlugin pluginName="MeshSkeletonizationPlugin"/>
    <RequiredPlugin pluginName="Sofa.GL.Component.Rendering3D"/>
    <RequiredPlugin pluginName="Sofa.Component.SceneUtility"/>
    <RequiredPlugin pluginName="Sofa.Component.IO.Mesh"/>
    <RequiredPlugin pluginName="Sofa.Component.Visual"/>

    <!--
      showBehaviorModels is required for SkeletonReader / SkeletonSegmentMapper /
      SkeletonResectionSimulator / TumorCutPointSelector draw() calls to render
      anything - separate from showVisualModels, which only affects OglModels.
    -->
    <VisualStyle displayFlags="showVisualModels showBehaviorModels showWireframe"/>

    <DefaultAnimationLoop/>
    <DefaultVisualManagerLoop/>

    <Node name="Mesh">
        <MeshOBJLoader name="loader" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Patient_08_venoussystem_visual.obj"/>

        <MeshSkeletonization template="Vec3d" name="skel"
            inputVertices="@loader.position"
            inputTriangles="@loader.triangles"
            outputSkeleton="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Patient_08_venoussystem_skeleton.txt"/>

        <Node name="visual">
            <OglModel src="@../loader"/>
        </Node>

        <SkeletonReader name="reader"
            filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Patient_08_venoussystem_skeleton.txt"
            inputVertices="@loader.position"
            outputVTK="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Patient_08_venoussystem_skeleton.vtk"
            outputReport="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Results\skeleton_report.csv"/>
    </Node>

    <Node name="LiverSegments">

        <MeshOBJLoader name="segII"   filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_II____Lat__Sup_collision.obj"/>
        <MeshOBJLoader name="segIII"  filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_III___Lat__Inf_collision.obj"/>
        <MeshOBJLoader name="segIVa"  filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_IVa___Med__Sup_collision.obj"/>
        <MeshOBJLoader name="segIVb"  filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_IVb___Med__Inf_collision.obj"/>
        <MeshOBJLoader name="segV"    filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_V_____Ant__Inf__R_collision.obj"/>
        <MeshOBJLoader name="segVI"   filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_VI____Post__Inf__R_collision.obj"/>
        <MeshOBJLoader name="segVII"  filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_VII___Post__Sup__R_collision.obj"/>
        <MeshOBJLoader name="segVIII" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\couinaud_Segment_VIII___Ant__Sup__R_collision.obj"/>

        <Node name="visII"><OglModel name="oglII" src="@../segII"/></Node>
        <Node name="visIII"><OglModel name="oglIII" src="@../segIII"/></Node>
        <Node name="visIVa"><OglModel name="oglIVa" src="@../segIVa"/></Node>
        <Node name="visIVb"><OglModel name="oglIVb" src="@../segIVb"/></Node>
        <Node name="visV"><OglModel name="oglV" src="@../segV"/></Node>
        <Node name="visVI"><OglModel name="oglVI" src="@../segVI"/></Node>
        <Node name="visVII"><OglModel name="oglVII" src="@../segVII"/></Node>
        <Node name="visVIII"><OglModel name="oglVIII" src="@../segVIII"/></Node>

        <SkeletonSegmentMapper name="segmentMapper" template="Vec3d"
            skeletonReader="@../Mesh/reader"
            segmentMeshes="@segII @segIII @segIVa @segIVb @segV @segVI @segVII @segVIII"
            segmentNames="II III IVa IVb V VI VII VIII"
            outSegmentReportFilename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Results\liver_segment_report.csv"/>
    </Node>

    <Node name="Tumors">

        <MeshOBJLoader name="tumor1Collision" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_collision_01.obj"/>
        <MeshOBJLoader name="tumor2Collision" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_collision_02.obj"/>
        <MeshOBJLoader name="tumor3Collision" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_collision_03.obj"/>

        <MeshOBJLoader name="tumor1Visual" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_visual_01.obj"/>
        <MeshOBJLoader name="tumor2Visual" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_visual_02.obj"/>
        <MeshOBJLoader name="tumor3Visual" filename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\tumor\Patient_08_tumor_visual_03.obj"/>

        <Node name="visTumor1"><OglModel name="oglTumor1" src="@../tumor1Visual" color="0.8 0.1 0.6 0.85"/></Node>
        <Node name="visTumor2"><OglModel name="oglTumor2" src="@../tumor2Visual" color="0.8 0.1 0.6 0.85"/></Node>
        <Node name="visTumor3"><OglModel name="oglTumor3" src="@../tumor3Visual" color="0.8 0.1 0.6 0.85"/></Node>

        <TumorCutPointSelector name="tumorSelector" template="Vec3d"
            tumorMeshes="@tumor1Collision @tumor2Collision @tumor3Collision"
            tumorNames="tumor-1 tumor-2 tumor-3"
            segmentMapper="@../LiverSegments/segmentMapper"/>
    </Node>

    <SkeletonResectionSimulator name="resectionSim" template="Vec3d"
        segmentMapper="@LiverSegments/segmentMapper"
        cutNodeIds="@Tumors/tumorSelector.cutNodeIds"
        activationDelay="5.0"
        segmentVisualModels="@LiverSegments/visII/oglII @LiverSegments/visIII/oglIII @LiverSegments/visIVa/oglIVa @LiverSegments/visIVb/oglIVb @LiverSegments/visV/oglV @LiverSegments/visVI/oglVI @LiverSegments/visVII/oglVII @LiverSegments/visVIII/oglVIII"
        outReportFilename="C:\Projects\Sofa\dev\sofa-plugins\MeshSkeletonization\data\patient_08\Results\resection_report.csv"/>

</Node>
